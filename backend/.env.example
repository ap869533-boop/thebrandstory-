# Production Server
PORT=8000
NODE_ENV=production
FRONTEND_URL=https://thebrandsstory.com
CORS_ORIGIN=https://thebrandsstory.com

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=StrongPassword123!
DB_NAME=brand_db
DB_PORT=3306

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# GEMINI_API_KEY=your_gemini_api_key
# SMTP Email Service (REQUIRED for Real Production OTP & Notifications)
# For Gmail: Use 'smtp.gmail.com', Port 587, your Gmail address, and a 16-character Google App Password (not normal login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="thebrandsstory." <your_email@gmail.com>
